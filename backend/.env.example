# Copy to backend/.env and fill in. Never commit the real .env.

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# SQLite for development, PostgreSQL for production
DATABASE_URI=sqlite:///student_expense.db
# DATABASE_URI=postgresql://user:password@localhost:5432/student_expense_db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# External AI API key (future chatbot integration)
# Comma-separated emails allowed to retrain the ML model
ADMIN_EMAILS=

AI_API_KEY=

FLASK_ENV=development
