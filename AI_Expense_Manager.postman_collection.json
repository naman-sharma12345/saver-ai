{
  "info": {
    "name": "SaverAI Expense Manager API",
    "description": "Comprehensive API collection for the AI-Powered Student Expense Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@example.com\",\n  \"password\": \"Test@123\",\n  \"role\": \"student\",\n  \"monthly_allowance\": 15000\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"access_token\", jsonData.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@test.com\",\n  \"password\": \"Test@123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Get Expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/expenses", "host": ["{{base_url}}"], "path": ["api", "expenses"] }
          }
        },
        {
          "name": "Create Expense (Auto-Categorize)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 350,\n  \"description\": \"Pizza from Dominos\",\n  \"store_name\": \"Dominos\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/expenses", "host": ["{{base_url}}"], "path": ["api", "expenses"] }
          }
        },
        {
          "name": "Get Anomalies",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/expenses/anomalies", "host": ["{{base_url}}"], "path": ["api", "expenses", "anomalies"] }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Financial Health Score",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/analytics/financial-health-score", "host": ["{{base_url}}"], "path": ["api", "analytics", "financial-health-score"] }
          }
        },
        {
          "name": "Next Month Prediction",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/analytics/next-month-prediction", "host": ["{{base_url}}"], "path": ["api", "analytics", "next-month-prediction"] }
          }
        }
      ]
    },
    {
      "name": "Stores & Recs",
      "item": [
        {
          "name": "Get Cheaper Alternatives",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expense_id\": 1\n}"
            },
            "url": { "raw": "{{base_url}}/api/stores/cheaper-alternatives", "host": ["{{base_url}}"], "path": ["api", "stores", "cheaper-alternatives"] }
          }
        },
        {
          "name": "Get Recommendations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/recommendations", "host": ["{{base_url}}"], "path": ["api", "recommendations"] }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}
